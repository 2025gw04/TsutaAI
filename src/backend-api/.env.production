# =================================
# TsutaAI 本番環境設定
# =================================
#
# 重要: このファイルは本番環境用のテンプレートです。
# 実際の本番環境では、このファイルをコピーして.envとして使用し、
# すべての値を本番環境用の安全な値に変更してください。

# 環境
NODE_ENV=production
PORT=3443

# JWT設定（必ず変更すること！）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_PRODUCTION_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=24h

# Groq API（本番用APIキーを設定）
GROQ_API_KEY=your-production-groq-api-key
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# データベース設定
# 本番環境ではMySQLまたはPostgreSQLを推奨
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=tsutaai_prod
DB_PASSWORD=CHANGE_THIS_TO_PRODUCTION_DB_PASSWORD
DB_NAME=tsutaai_production

# HTTPS設定（必須）
ENABLE_HTTPS=true
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem

# プロキシ設定（必要な場合）
PROXY_ENABLED=false
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# ログ設定
LOG_LEVEL=info
LOG_DIR=/var/log/tsutaai
LOG_TO_CONSOLE=false

# レート制限設定
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW_MS=900000

# セキュリティ設定（必ず変更すること！）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_THIS_TO_PRODUCTION_ENCRYPTION_KEY_MIN_32_CHARS

# CORS設定（本番ドメインを設定）
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# バックアップ設定
BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/tsutaai
BACKUP_RETENTION_DAYS=30
