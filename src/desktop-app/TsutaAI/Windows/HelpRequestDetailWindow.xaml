<Window x:Class="TsutaAI.Windows.HelpRequestDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="通知詳細"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource WindowBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Border Grid.Column="0" 
                        Width="40" Height="40" 
                        CornerRadius="20" 
                        Background="#2D2D30" 
                        Margin="0,0,15,0">
                    <iconPacks:PackIconMaterial Kind="BellRing" 
                                              Foreground="{StaticResource PrimaryBrush}" 
                                              Width="20" Height="20" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Date -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationTitleText" 
                               Text="通知タイトル" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="NotificationDateText" 
                               Text="2023/01/01 12:00" 
                               FontSize="14" 
                               Foreground="{StaticResource TextLightBrush}" 
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status Badge (Optional) -->
                <Border x:Name="UrgencyBadge" 
                        Grid.Column="2" 
                        Background="#FF5252" 
                        CornerRadius="4" 
                        Padding="8,4" 
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="UrgencyText" 
                               Text="HIGH" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Main Message -->
                <TextBlock Text="詳細内容" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextLightBrush}" 
                           Margin="0,0,0,5"/>
                
                <Border Background="{StaticResource BackgroundBrush}" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,20">
                    <TextBlock x:Name="MessageText" 
                               Text="ここに通知のメッセージが入ります。" 
                               FontSize="16" 
                               Foreground="{StaticResource TextBrush}" 
                               TextWrapping="Wrap" 
                               FontWeight="Bold"
                               LineHeight="22"/>
                </Border>

                <!-- Help Request Specific Details -->
                <StackPanel x:Name="HelpRequestDetailsPanel" Visibility="Collapsed">
                    <!-- Description -->
                    <TextBlock Text="リクエスト説明" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextLightBrush}" 
                               Margin="0,0,0,5"/>
                    <Border Background="{StaticResource BackgroundBrush}" 
                            CornerRadius="8" 
                            Padding="15" 
                            Margin="0,0,0,20">
                        <TextBlock x:Name="DescriptionText" 
                                   Text="ここにリクエストの詳細な説明が入ります。" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" 
                                   TextWrapping="Wrap" 
                                   LineHeight="22"/>
                    </Border>

                    <!-- AI Analysis -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Robot" 
                                                  Foreground="{StaticResource AccentBrush}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" 
                                   Text="AIによる分析" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource AccentBrush}" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Border Background="#1A2332" 
                            BorderBrush="{StaticResource AccentBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="15">
                        <TextBlock x:Name="AiAnalysisText" 
                                   Text="AIによる分析結果がここに表示されます。" 
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   Foreground="#D0E6FF" 
                                   TextWrapping="Wrap" 
                                   LineHeight="20"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="{StaticResource WindowBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" 
                        Content="閉じる" 
                        Width="100" 
                        Height="35" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
