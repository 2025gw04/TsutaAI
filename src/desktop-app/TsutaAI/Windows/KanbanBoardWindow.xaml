<Window x:Class="TsutaAI.Windows.KanbanBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="🎯 TsutaAI - マイタスクボード"
        Width="1400"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindowStyle}"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- ローカルスタイルは不要になり、グローバルスタイルを使用します -->
    </Window.Resources>

    <!-- メインレイアウト -->
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <!-- ヘッダーバー -->
            <RowDefinition Height="*"/>
            <!-- メインコンテンツ（看板ボード） -->
            <RowDefinition Height="auto"/>
            <!-- フッターバー -->
        </Grid.RowDefinitions>

        <!-- ========== ヘッダー ========== -->
        <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- タイトル -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="26" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="マイタスクボード" Style="{StaticResource H2}" FontSize="20"/>
                        <TextBlock x:Name="ProjectNameText" Text="プロジェクト名" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右側アクション -->
                <Button Grid.Column="1"
                        Name="FilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Click="FilterButton_Click"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <iconPacks:PackIconBoxIcons Kind="RegularFilter" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="フィルター" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Name="AddPersonalTaskButton"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddPersonalTaskButton_Click"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <iconPacks:PackIconBoxIcons Kind="RegularPlus" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="個人タスク追加" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!--<Button Grid.Column="3"
                        Name="CloseButton"
                        Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"
                        Padding="8"
                        ToolTip="閉じる">
                    <iconPacks:PackIconBoxIcons Kind="RegularX" Margin="15,0"/>
                </Button>-->
            </Grid>
        </Border>

        <!-- ========== メインコンテンツ（看板ボード） ========== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="KanbanBoardPanel"
                       Orientation="Horizontal"
                       Margin="20"
                       Background="{StaticResource BackgroundBrush}">
                <!-- 看板列はコードビハインドで動的に生成される -->
            </StackPanel>
        </ScrollViewer>

        <!-- ========== フッター ========== -->
        <Border Grid.Row="2" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- ステータス表示 -->
                <TextBlock Grid.Column="0"
                          Name="StatusText"
                          Text="タスク読み込み中..."
                          Style="{StaticResource MutedTextStyle}"
                          VerticalAlignment="Center"/>

                <!-- ナビゲーションボタン --><!--
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                           Click="BackToDashboard_Click"
                           Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="15,0">
                            <iconPacks:PackIconBoxIcons Kind="RegularHome" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ダッシュボードに戻る" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                           Click="OpenWebAdmin_Click">
                        <StackPanel Orientation="Horizontal" Margin="15,0">
                            <iconPacks:PackIconBoxIcons Kind="RegularGlobe" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Web管理画面を開く" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>-->
            </Grid>
        </Border>
    </Grid>
</Window>