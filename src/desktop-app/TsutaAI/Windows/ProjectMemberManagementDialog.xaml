<Window x:Class="TsutaAI.Windows.ProjectMemberManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロジェクトメンバー管理" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource BaseWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- プロジェクト情報 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="プロジェクト名"
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="ProjectNameText"
                       Style="{StaticResource H2}"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- ツールバー -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="MemberCountText"
                       Text="0人のメンバー"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    x:Name="AddMemberButton"
                    Content="＋ メンバー追加"
                    Width="140"
                    Click="AddMemberButton_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>

        <!-- メンバー一覧 -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource WindowBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- ローディング表示 -->
                    <TextBlock x:Name="LoadingText"
                               Text="メンバーを読み込み中..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="16"/>

                    <!-- メンバーなし表示 -->
                    <TextBlock x:Name="NoMembersText"
                               Text="メンバーがいません。追加してください。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="16"
                               Visibility="Collapsed"/>

                    <!-- メンバーリスト -->
                    <ItemsControl x:Name="MembersList"
                                  Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- アイコン -->
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="20">
                                            <TextBlock Text="{Binding UserInitial}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- ユーザー情報 -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Body}"
                                                       FontWeight="Bold">
                                                <Run Text="{Binding FullName}"/>
                                                <Run Text="{Binding UserName, StringFormat='(@{0})'}" 
                                                     FontWeight="Normal" 
                                                     FontSize="14" 
                                                     Foreground="{StaticResource TextLightBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding UserEmail}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- ロール選択 -->
                                        <ComboBox Grid.Column="2"
                                                  Height="36"
                                                  Style="{StaticResource ModernComboBox}"
                                                  SelectedIndex="{Binding RoleIndex, Mode=OneWay}"
                                                  Tag="{Binding}"
                                                  SelectionChanged="RoleComboBox_SelectionChanged"
                                                  Margin="0,0,16,0">
                                            <ComboBoxItem Content="オーナー" Tag="owner"/>
                                            <ComboBoxItem Content="メンバー" Tag="member"/>
                                            <ComboBoxItem Content="閲覧者" Tag="viewer"/>
                                        </ComboBox>

                                        <!-- 削除ボタン -->
                                        <Button Grid.Column="3"
                                                Content="削除"
                                                Tag="{Binding}"
                                                Click="RemoveMemberButton_Click"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,4"
                                                FontSize="14"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="閉じる"
                    Width="120"
                    Click="CloseButton_Click"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"/>
            
            <Button x:Name="SaveButton"
                    Content="保存"
                    Width="120"
                    Click="SaveButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>