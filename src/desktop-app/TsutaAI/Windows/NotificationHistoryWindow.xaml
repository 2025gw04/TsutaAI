<Window x:Class="TsutaAI.Windows.NotificationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:models="clr-namespace:TsutaAI.Models"
        xmlns:converters="clr-namespace:TsutaAI.Converters"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="通知履歴"
        Height="600"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBoxIcons Kind="RegularBell" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="通知一覧" Style="{StaticResource H2}" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1"
                        x:Name="MarkAllReadButton"
                        Style="{StaticResource TextButton}"
                        Click="MarkAllReadButton_Click"
                        ToolTip="すべて既読にする">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="すべて既読" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 通知リスト -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="NotificationsStackPanel" Margin="15">
                <TextBlock x:Name="EmptyMessageTextBlock"
                           Text="通知はありません"
                           Style="{StaticResource LightText}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="Collapsed"/>
                
                <ItemsControl x:Name="NotificationsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Notification}">
                            <Border Background="{StaticResource WindowBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="NotificationItem_MouseLeftButtonUp"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 未読インジケーター -->
                                    <Ellipse Grid.Column="0"
                                             Width="8"
                                             Height="8"
                                             Fill="{StaticResource ErrorBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,5,10,0"
                                             Visibility="{Binding IsRead, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="14"/>
                                        <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource LightText}" FontSize="13"/>
                                    </StackPanel>

                                    <!-- 既読ボタン -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource TextButton}"
                                            VerticalAlignment="Top"
                                            Click="MarkAsReadButton_Click"
                                            Tag="{Binding}"
                                            ToolTip="既読にする"
                                            Visibility="{Binding IsRead, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <iconPacks:PackIconBoxIcons Kind="RegularCheck" Foreground="{StaticResource SuccessBrush}"/>
                                    </Button>

                                    <!-- 未読に戻すボタン -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource TextButton}"
                                            VerticalAlignment="Top"
                                            Click="MarkAsUnreadButton_Click"
                                            Tag="{Binding}"
                                            ToolTip="未読に戻す"
                                            Visibility="{Binding IsRead, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <iconPacks:PackIconBoxIcons Kind="RegularEnvelope" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
