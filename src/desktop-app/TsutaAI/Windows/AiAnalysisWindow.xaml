<Window x:Class="TsutaAI.Windows.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource BaseWindowStyle}"
        Title="AI活動分析結果" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        >
    <Window.Resources>
        <!-- このウィンドウ内で使用するローカルスタイル -->
        <Style x:Key="ScoreCardStyle" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="ScoreTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ScoreValueStyle" TargetType="TextBlock" BasedOn="{StaticResource H1}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <!--<Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="30,25" MouseDown="HeaderBd_MouseDown" Background="{StaticResource PrimaryGradientBrush}">
            <StackPanel>
                <TextBlock Text="AI活動分析結果" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtDateRange" Text="本日の分析結果" FontSize="16" Foreground="{StaticResource TextWhiteBrush}"/>
            </StackPanel>
        </Border>-->

        <!-- ========== ヘッダー ========== -->
        <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- タイトル -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconBoxIcons2 Kind="RegularBarChart" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,3,10,0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="AI活動分析結果" Style="{StaticResource H2}" FontSize="20"/>
                        <TextBlock x:Name="txtDateRange" Text="本日の分析結果" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>


        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- スコアカード -->
            <Grid Grid.Row="0" Margin="20,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ScoreCardStyle}">
                    <StackPanel>
                        <TextBlock Text="集中度スコア" Style="{StaticResource ScoreTitleStyle}"/>
                        <TextBlock x:Name="txtConcentrationScore" Text="0" Style="{StaticResource ScoreValueStyle}" Foreground="{StaticResource PrimaryBrush}"/>
                        <ProgressBar x:Name="progressConcentration" Style="{StaticResource ModernProgressBar}" Foreground="{StaticResource PrimaryBrush}" Margin="0,15,0,0"/>
                        <TextBlock x:Name="txtConcentrationStatus" Text="評価待ち" FontSize="14" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ScoreCardStyle}">
                    <StackPanel>
                        <TextBlock Text="進捗度スコア" Style="{StaticResource ScoreTitleStyle}"/>
                        <TextBlock x:Name="txtProgressScore" Text="0" Style="{StaticResource ScoreValueStyle}" Foreground="{StaticResource InfoBrush}"/>
                        <ProgressBar x:Name="progressProgress" Style="{StaticResource ModernProgressBar}" Foreground="{StaticResource InfoBrush}" Margin="0,15,0,0"/>
                        <TextBlock x:Name="txtProgressStatus" Text="評価待ち" FontSize="14" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ScoreCardStyle}">
                    <StackPanel>
                        <TextBlock Text="効率性スコア" Style="{StaticResource ScoreTitleStyle}"/>
                        <TextBlock x:Name="txtEfficiencyScore" Text="0" Style="{StaticResource ScoreValueStyle}" Foreground="{StaticResource WarningBrush}"/>
                        <ProgressBar x:Name="progressEfficiency" Style="{StaticResource ModernProgressBar}" Foreground="{StaticResource WarningBrush}" Margin="0,15,0,0"/>
                        <TextBlock x:Name="txtEfficiencyStatus" Text="評価待ち" FontSize="14" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="1" Margin="10,0">
                <!-- TabControl Styles from TaskDetailWindow.xaml -->
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Margin="0,0,2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons2 Kind="RegularPieChartAlt" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="最新の分析結果" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="AI分析サマリー" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtSummary" TextWrapping="Wrap" Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="🔍 検出された問題点" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                        <ListBox x:Name="lstIssues" BorderThickness="0" Background="Transparent"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 改善提案" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                        <ListBox x:Name="lstRecommendations" BorderThickness="0" Background="Transparent"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="📊 活動データ詳細" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="入力統計" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="txtMouseClicks" Text="マウスクリック: 0回" Margin="0,3"/>
                                            <TextBlock x:Name="txtKeyPresses" Text="キー入力: 0回" Margin="0,3"/>
                                            <TextBlock x:Name="txtActiveTime" Text="アクティブ時間: 0分" Margin="0,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="コード編集" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="txtFileChanges" Text="ファイル変更: 0個" Margin="0,3"/>
                                            <TextBlock x:Name="txtLinesAdded" Text="追加行数: 0行" Margin="0,3" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock x:Name="txtLinesRemoved" Text="削除行数: 0行" Margin="0,3" Foreground="{StaticResource ErrorBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="システムリソース" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="txtCpuUsage" Text="平均CPU: 0%" Margin="0,3"/>
                                            <TextBlock x:Name="txtMemoryUsage" Text="平均メモリ: 0MB" Margin="0,3"/>
                                            <TextBlock x:Name="txtActivityIntensity" Text="活動強度: -" Margin="0,3"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularHistory" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="分析履歴" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="表示期間: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbPeriod" Style="{StaticResource ModernComboBox}" Width="150" SelectionChanged="CmbPeriod_SelectionChanged" Margin="10,0,0,0">
                                            <ComboBoxItem Content="本日" IsSelected="True" Tag="today"/>
                                            <ComboBoxItem Content="過去7日間" Tag="week"/>
                                            <ComboBoxItem Content="過去30日間" Tag="month"/>
                                        </ComboBox>
                                        <Button Content="更新" Style="{StaticResource PrimaryButton}" Width="80" Height="40" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
                                    </StackPanel>
                                    <DataGrid x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9F9F9" SelectionMode="Single" SelectionChanged="DgHistory_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="時刻" Binding="{Binding HourStart, StringFormat='yyyy/MM/dd HH:mm'}" Width="150"/>
                                            <DataGridTextColumn Header="集中度" Binding="{Binding ConcentrationScore}" Width="80"/>
                                            <DataGridTextColumn Header="進捗度" Binding="{Binding ProgressScore}" Width="80"/>
                                            <DataGridTextColumn Header="効率性" Binding="{Binding EfficiencyScore}" Width="80"/>
                                            <DataGridTextColumn Header="活動強度" Binding="{Binding ActivityIntensity}" Width="100"/>
                                            <DataGridTextColumn Header="ステータス" Binding="{Binding AiAnalysisStatus}" Width="100"/>
                                            <DataGridTextColumn Header="サマリー" Binding="{Binding Summary}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="20">
            <Button Content="閉じる" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="100" Height="42" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>