<Window x:Class="TsutaAI.Windows.PersonalTaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="個人タスク編集"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Style="{StaticResource BaseWindowStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <!-- タイトル入力 -->
            <RowDefinition Height="auto"/>
            <!-- スペーサー -->
            <RowDefinition Height="auto"/>
            <!-- 説明入力 -->
            <RowDefinition Height="auto"/>
            <!-- スペーサー -->
            <RowDefinition Height="auto"/>
            <!-- 優先度選択 -->
            <RowDefinition Height="auto"/>
            <!-- スペーサー -->
            <RowDefinition Height="auto"/>
            <!-- 見積時間入力 -->
            <RowDefinition Height="auto"/>
            <!-- スペーサー -->
            <RowDefinition Height="auto"/>
            <!-- メモ入力 -->
            <RowDefinition Height="auto"/>
            <!-- スペーサー -->
            <RowDefinition Height="auto"/>
            <!-- 初期ステータス -->
            <RowDefinition Height="*"/>
            <!-- 余白 -->
            <RowDefinition Height="auto"/>
            <!-- ボタン -->
        </Grid.RowDefinitions>

        <!-- === タイトル === -->
        <TextBlock Grid.Row="0"
                   Text="タスクタイトル *"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TextBox Grid.Row="0"
                 Name="TitleTextBox"
                 Style="{StaticResource ModernTextBox}"
                 Margin="0,30,0,0"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 Text="新しいタスク"/>

        <!-- スペーサー -->
        <Border Grid.Row="2" Height="20"/>

        <!-- === 説明 === -->
        <TextBlock Grid.Row="3"
                   Text="説明（任意）"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TextBox Grid.Row="3"
                 Name="DescriptionTextBox"
                 Style="{StaticResource ModernTextBox}"
                 Margin="0,30,0,0"
                 Height="80"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- スペーサー -->
        <Border Grid.Row="5" Height="20"/>

        <!-- === 優先度 === -->
        <TextBlock Grid.Row="6"
                   Text="優先度"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,32,0,0">
            <RadioButton Name="PriorityHighRadio"
                         Content="高"
                         Style="{StaticResource NavButtonStyle}"
                         Margin="0,0,20,0"/>

            <RadioButton Name="PriorityMediumRadio"
                         Content="中"
                         IsChecked="True"
                         Style="{StaticResource NavButtonStyle}"
                         Margin="0,0,20,0"/>

            <RadioButton Name="PriorityLowRadio"
                         Content="低"
                         Style="{StaticResource NavButtonStyle}"
                         Margin="0,0,0,0"/>
        </StackPanel>

        <!-- スペーサー -->
        <Border Grid.Row="8" Height="20"/>

        <!-- === 見積時間 === -->
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="見積時間（分）"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     Name="EstimatedMinutesTextBox"
                     Width="100"
                     Style="{StaticResource ModernTextBox}"
                     TextAlignment="Center"
                     Text="30"/>
        </Grid>

        <!-- スペーサー -->
        <Border Grid.Row="10" Height="20"/>

        <!-- === メモ === -->
        <TextBlock Grid.Row="11"
                   Text="メモ（任意）"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TextBox Grid.Row="11"
                 Name="NotesTextBox"
                 Style="{StaticResource ModernTextBox}"
                 Margin="0,30,0,0"
                 Height="80"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- === 初期ステータス === -->
        <TextBlock Grid.Row="12"
                   Text="初期ステータス"
                   FontWeight="Bold"
                   Margin="0,20,0,10"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,50,0,0">
            <RadioButton Name="StatusNotStartedRadio"
                         Content="未着手"
                         IsChecked="True"
                         Style="{StaticResource NavButtonStyle}"
                         Margin="0,0,20,0"/>

            <RadioButton Name="StatusInProgressRadio"
                         Content="進行中"
                         Style="{StaticResource NavButtonStyle}"
                         Margin="0,0,20,0"/>

            <RadioButton Name="StatusDoneRadio"
                         Content="完了"
                         Style="{StaticResource NavButtonStyle}"
                         Margin="0,0,0,0"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="14"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">

            <Button Name="CancelButton"
                    Content="キャンセル"
                    Width="120"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButton}"/>

            <Button Name="SaveButton"
                    Content="保存"
                    Width="120"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>