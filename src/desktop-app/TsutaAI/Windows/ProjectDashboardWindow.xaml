<Window x:Class="TsutaAI.Windows.ProjectDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="プロジェクトダッシュボード"
        Height="880" Width="1100"
        Style="{StaticResource BaseWindowStyle}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Button Styles using Styles.xaml -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <!--<Border Grid.Row="0" Background="{StaticResource PrimaryGradientBrush}" CornerRadius="10,10,0,0" MouseDown="HeaderBd_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                        <iconPacks:PackIconBoxIcons Kind="RegularStats" VerticalAlignment="Center" Foreground="White" Width="24" Height="24"/>
                        <TextBlock Text="プロジェクトダッシュボード" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="50" Height="50" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="22" Click="BtnClose_Click" Cursor="Hand"/>
                </Grid>
            </Border>-->

        <!-- ========== ヘッダー ========== -->
        <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- タイトル -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconBoxIcons2 Kind="RegularStats" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,3,10,0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="プロジェクトダッシュボード" Style="{StaticResource H2}" FontSize="20"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Project Selection -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="プロジェクト選択" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="cmbProjects" DisplayMemberPath="Name" SelectionChanged="CmbProjects_SelectionChanged" Style="{StaticResource ModernComboBox}"/>
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Margin="0,0,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Margin="0,0,2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <!-- Health Score Tab -->
                <TabItem Header="ヘルススコア">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="プロジェクトヘルススコア" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <Button Content="更新" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnRefreshHealthScore_Click"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Width="150" Height="150" Margin="0,0,30,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="txtHealthScore" Text="--" FontSize="50" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="/ 100" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="詳細スコア" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="30"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="進捗スコア:" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtProgressScore" Text="--" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="納期スコア:" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDeadlineScore" Text="--" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="チームモラルスコア:" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtTeamMoraleScore" Text="--" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="ブロッカースコア:" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtBlockerScore" Text="--" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ベロシティスコア:" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtVelocityScore" Text="--" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="AI分析" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,10"/>
                                    <TextBox x:Name="txtAiAnalysis" IsReadOnly="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}" Background="{StaticResource BackgroundBrush}"/>

                                    <TextBlock Text="リスク要因" FontWeight="SemiBold" FontSize="16" Margin="0,15,0,10"/>
                                    <TextBox x:Name="txtRiskFactors" IsReadOnly="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}" Background="{StaticResource BackgroundBrush}"/>

                                    <TextBlock Text="推奨事項" FontWeight="SemiBold" FontSize="16" Margin="0,15,0,10"/>
                                    <TextBox x:Name="txtRecommendations" IsReadOnly="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}" Background="{StaticResource BackgroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ヘルススコア履歴" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="dgHealthScoreHistory" AutoGenerateColumns="False" IsReadOnly="True" Height="200" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="日付" Binding="{Binding ScoreDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="120"/>
                                            <DataGridTextColumn Header="スコア" Binding="{Binding HealthScore}" Width="80"/>
                                            <DataGridTextColumn Header="進捗" Binding="{Binding ProgressScore}" Width="80"/>
                                            <DataGridTextColumn Header="納期" Binding="{Binding DeadlineScore}" Width="80"/>
                                            <DataGridTextColumn Header="モラル" Binding="{Binding TeamMoraleScore}" Width="80"/>
                                            <DataGridTextColumn Header="ブロッカー" Binding="{Binding BlockerScore}" Width="100"/>
                                            <DataGridTextColumn Header="ベロシティ" Binding="{Binding VelocityScore}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Burndown Chart Tab -->
                <TabItem Header="バーンダウン">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="バーンダウンチャート" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <Button Content="更新" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnRefreshBurndown_Click"/>
                                    </Grid>

                                    <TextBlock Text="バーンダウンデータ" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,10"/>
                                    <DataGrid x:Name="dgBurndownData" AutoGenerateColumns="False" IsReadOnly="True" Height="300" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="日付" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                            <DataGridTextColumn Header="予定残タスク" Binding="{Binding PlannedRemainingTasks}" Width="110"/>
                                            <DataGridTextColumn Header="実際残タスク" Binding="{Binding ActualRemainingTasks}" Width="110"/>
                                            <DataGridTextColumn Header="予定残時間" Binding="{Binding PlannedRemainingHours, StringFormat='{}{0:F1}h'}" Width="100"/>
                                            <DataGridTextColumn Header="実際残時間" Binding="{Binding ActualRemainingHours, StringFormat='{}{0:F1}h'}" Width="100"/>
                                            <DataGridTextColumn Header="完了タスク" Binding="{Binding CompletedTasksCount}" Width="100"/>
                                            <DataGridTextColumn Header="完了時間" Binding="{Binding CompletedHours, StringFormat='{}{0:F1}h'}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="※ バーンダウンチャートの視覚化は将来のバージョンで実装予定" FontStyle="Italic" Foreground="{StaticResource TextLightBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Critical Path Tab -->
                <TabItem Header="クリティカルパス">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="クリティカルパス分析" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <Button Content="分析実行" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" 
                                                    Width="90"
                                                    Click="BtnAnalyzeCriticalPath_Click"/>
                                    </Grid>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="クリティカルタスク数" FontSize="14" Foreground="{StaticResource TextLightBrush}"/>
                                                <TextBlock x:Name="txtCriticalTasksCount" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="5,0">
                                            <StackPanel>
                                                <TextBlock Text="最長パス日数" FontSize="14" Foreground="{StaticResource TextLightBrush}"/>
                                                <TextBlock x:Name="txtLongestPathDays" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="予測終了日" FontSize="14" Foreground="{StaticResource TextLightBrush}"/>
                                                <TextBlock x:Name="txtProjectEndDate" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="クリティカルタスク一覧" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,10"/>
                                    <ListBox x:Name="lstCriticalTasks" Height="200" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9F9F9" CornerRadius="4" Padding="10" Margin="0,2">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding TaskId, StringFormat='タスクID: {0}'}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                            <TextBlock Text="{Binding SlackDays, StringFormat='余裕: {0}日'}" HorizontalAlignment="Right" Foreground="{StaticResource ErrorBrush}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding ImpactAnalysis}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="リスク" FontWeight="SemiBold" FontSize="16" Margin="0,15,0,10"/>
                                    <ListBox x:Name="lstCriticalPathRisks" Height="80" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                    <TextBlock Text="推奨事項" FontWeight="SemiBold" FontSize="16" Margin="0,15,0,10"/>
                                    <ListBox x:Name="lstCriticalPathRecommendations" Height="80" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Sprint Management Tab -->
                <TabItem Header="スプリント">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="スプリント管理" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <Button Content="更新" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnRefreshSprints_Click"/>
                                    </Grid>

                                    <TextBlock Text="アクティブスプリント" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,10"/>
                                    <DataGrid x:Name="dgActiveSprints" AutoGenerateColumns="False" IsReadOnly="True" Height="150" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="スプリント名" Binding="{Binding SprintName}" Width="150"/>
                                            <DataGridTextColumn Header="開始日" Binding="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                            <DataGridTextColumn Header="終了日" Binding="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                            <DataGridTextColumn Header="ステータス" Binding="{Binding Status}" Width="100"/>
                                            <DataGridTextColumn Header="完了タスク" Binding="{Binding CompletedTaskCount}" Width="100"/>
                                            <DataGridTextColumn Header="総タスク" Binding="{Binding TargetTaskCount}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="完了スプリント" FontWeight="SemiBold" FontSize="16" Margin="0,15,0,10"/>
                                    <DataGrid x:Name="dgCompletedSprints" AutoGenerateColumns="False" IsReadOnly="True" Height="150" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="スプリント名" Binding="{Binding SprintName}" Width="150"/>
                                            <DataGridTextColumn Header="開始日" Binding="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                            <DataGridTextColumn Header="終了日" Binding="{Binding EndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                            <DataGridTextColumn Header="完了タスク" Binding="{Binding CompletedTaskCount}" Width="100"/>
                                            <DataGridTextColumn Header="達成率" Binding="{Binding AchievabilityScore, StringFormat='{}{0:P0}'}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="Transparent" Padding="10" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconBoxIcons Kind="RegularInfoCircle" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtStatus" Text="準備完了" VerticalAlignment="Center" FontSize="16"/>
                </StackPanel>
            </Border>

            <!--<Border Grid.Row="2"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
                <TextBlock x:Name="txtStatus"
                       Text="準備完了"
                       Style="{StaticResource MutedTextStyle}"/>
            </Border>-->

        </Grid>
    </Grid>
</Window>