<Window x:Class="TsutaAI.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:models="clr-namespace:TsutaAI.Models"
        mc:Ignorable="d"
        Title="TsutaAI 作業ウィジェット"
        Width="360"
        Height="510"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource WidgetBackgroundBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource WidgetBackgroundBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="20" ShadowDepth="8"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="▶ 現在のタスク"
                           Foreground="{StaticResource TextDisabledBrush}"
                           FontSize="15"/>
                <TextBlock x:Name="TaskTitleTextBlock"
                           Text="タスクを読み込み中..."
                           Foreground="{StaticResource TextWhiteBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Timer / activity -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock x:Name="ElapsedTimeTextBlock"
                           Text="00:00:00"
                           Foreground="{StaticResource TextWhiteBrush}"
                           FontSize="38"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="TaskProgressBar"
                             Style="{StaticResource ModernProgressBar}"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#34495E"
                             Height="10"
                             Margin="0,10,0,0"/>
                <TextBlock x:Name="ActivityStatsTextBlock"
                           Text=""
                           Foreground="{StaticResource TextDisabledBrush}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>

            <!-- AI Analysis Notification -->
            <Border x:Name="AiNotificationBorder"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    CornerRadius="8"
                    Background="#3060C664"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1"
                    Padding="12,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="AI分析レポート"
                                       Foreground="{StaticResource TextWhiteBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                        </StackPanel>
                        <Button x:Name="CloseNotificationButton"
                                Grid.Column="1"
                                Content="×"
                                Width="20"
                                Height="20"
                                FontSize="16"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextDisabledBrush}"
                                Cursor="Hand"
                                Click="CloseNotificationButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="AiNotificationText"
                               Text="休憩を取ることをお勧めします"
                               Foreground="{StaticResource TextWhiteBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="16"/>
                    <Button x:Name="ViewDetailsButton"
                            Content="詳細を見る"
                            Style="{StaticResource SecondaryButton}"
                            Height="24"
                            FontSize="13"
                            Margin="0,8,0,0"
                            Padding="12,0"
                            Click="ViewDetailsButton_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Task list -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="タスクリスト"
                               Foreground="{StaticResource TextDisabledBrush}"
                               FontSize="15"/>

                    <Button x:Name="ReorderTasksButton"
                            Grid.Column="1"
                            Content="並び替えヒント"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="13"
                            Height="24"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            Click="ReorderTasksButton_Click"
                            Visibility="Collapsed"/>
                </Grid>

                <ListBox x:Name="TaskListItemsControl"
                         Background="Transparent"
                         BorderThickness="0"
                         AllowDrop="True"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TaskList_PreviewMouseMove"
                         DragOver="TaskList_DragOver"
                         Drop="TaskList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TaskItem}">
                            <Border Background="Transparent"
                                    Margin="0,3"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="TaskItem_Click"
                                    Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#304155"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Red dot indicator for unread changes -->
                                        <Ellipse Grid.Column="0"
                                                Width="8"
                                                Height="8"
                                                Fill="#FF4444"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnreadChanges}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                                    <Setter Property="TextDecorations" Value="None"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="#60748A"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PauseResumeButton"
                            Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Background="#4A6585"
                            Foreground="{StaticResource TextWhiteBrush}"
                            BorderThickness="0"
                            Height="42"
                            Margin="0,0,5,0"
                            Click="PauseResumeButton_Click"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconBoxIcons x:Name="PauseResumeIcon"
                                                        Kind="RegularPause"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock x:Name="PauseResumeTextBlock"
                                       Text="一時停止"
                                       VerticalAlignment="Center"
                                       FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CompleteButton"
                            Grid.Column="1"
                            Style="{StaticResource SuccessButton}"
                            Height="42"
                            Margin="5,0,0,0"
                            Click="CompleteButton_Click"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconBoxIcons Kind="RegularCheck"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="完了"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Button x:Name="OpenKanbanButton"
                        Style="{StaticResource SecondaryButton}"
                        Height="36"
                        Margin="0,8,0,0"
                        Click="OpenKanbanButton_Click"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconBoxIcons Kind="RegularGrid"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="ボードを開く"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                    </StackPanel>
                </Button>

                <Button x:Name="EndWorkDayButton"
                        Style="{StaticResource WarningButton}"
                        Height="38"
                        Margin="0,10,0,0"
                        Click="EndWorkDayButton_Click"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconBoxIcons Kind="RegularMoon"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="本日の作業を終了"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Window buttons -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="NotificationsButton"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="Transparent"
                        Foreground="{StaticResource TextDisabledBrush}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="NotificationsButton_Click"
                        ToolTip="通知">
                    <Grid>
                        <iconPacks:PackIconBoxIcons Kind="RegularBell"/>
                        <Ellipse x:Name="NotificationBadge" Width="6" Height="6" Fill="#FF4444" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,2,0" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="Transparent"
                        Foreground="{StaticResource TextDisabledBrush}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="MinimizeButton_Click"
                        ToolTip="システムトレイに最小化">
                    <iconPacks:PackIconBoxIcons Kind="RegularMinus"/>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="Transparent"
                        Foreground="{StaticResource TextDisabledBrush}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Click="CloseButton_Click"
                        ToolTip="ダッシュボードに戻る">
                    <iconPacks:PackIconBoxIcons Kind="RegularX"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>