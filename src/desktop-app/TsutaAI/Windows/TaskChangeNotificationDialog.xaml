<Window x:Class="TsutaAI.Windows.TaskChangeNotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="タスク変更通知"
        Width="550"
        Height="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="{StaticResource WidgetBackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="15" ShadowDepth="5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconBoxIcons Grid.Column="0"
                                           Kind="RegularBell"
                                           Width="28"
                                           Height="28"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="タスク変更通知"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextWhiteBrush}"/>
                    <TextBlock x:Name="SubtitleTextBlock"
                               Text="管理者によりタスクが更新されました"
                               FontSize="15"
                               Foreground="{StaticResource TextDisabledBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="×"
                        Width="32"
                        Height="32"
                        FontSize="22"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextDisabledBrush}"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        VerticalAlignment="Top">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15">
                <ItemsControl x:Name="ChangesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E2A38"
                                   CornerRadius="8"
                                   Padding="15"
                                   Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Task Title -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                Width="8"
                                                Height="8"
                                                Fill="#FF4444"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding TaskTitle}"
                                                  FontSize="17"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource TextWhiteBrush}"
                                                  TextWrapping="Wrap"/>
                                    </Grid>

                                    <!-- Changes List -->
                                    <ItemsControl ItemsSource="{Binding Changes}"
                                                 Margin="18,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="•"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              FontSize="16"
                                                              Margin="0,0,8,0"/>

                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding}"
                                                              FontSize="15"
                                                              Foreground="{StaticResource TextDisabledBrush}"
                                                              TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Updated Time -->
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='更新日時: {0}'}"
                                              FontSize="13"
                                              Foreground="#60748A"
                                              Margin="18,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Button x:Name="ConfirmButton"
                    Grid.Row="2"
                    Content="確認しました"
                    Style="{StaticResource PrimaryButton}"
                    Height="42"
                    FontSize="16"
                    Click="ConfirmButton_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource AccentBrush}"
                               CornerRadius="8"
                               BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
