<Window x:Class="TsutaAI.Windows.HelpRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ヘルプリクエスト作成" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock x:Name="HeaderTitle" Text="ヘルプリクエスト作成" Style="{StaticResource H1}"/>
            <TextBlock x:Name="HeaderSubtitle" Text="困っていることがあれば、チームメンバーに助けを求めましょう"
                       Style="{StaticResource Body}"
                       Foreground="{StaticResource TextLightBrush}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Input View -->
        <ScrollViewer x:Name="InputView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Task Selection -->
                <TextBlock Text="対象タスク *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox x:Name="TaskComboBox"
                          DisplayMemberPath="Title"
                          SelectedValuePath="Id"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20"/>

                <!-- Title -->
                <TextBlock Text="タイトル *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="TitleTextBox"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,20"
                         FontWeight="Bold"
                         MaxLength="200"/>

                <!-- Description -->
                <TextBlock Text="詳細説明" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="DescriptionTextBox"
                         Style="{StaticResource ModernTextBox}"
                         Height="120"
                         FontWeight="Bold"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20"
                         VerticalContentAlignment="Top"
                         Padding="7,7"
                         />

                <!-- Urgency -->
                <TextBlock Text="緊急度" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox x:Name="UrgencyComboBox"
                          SelectedIndex="1"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="低" Tag="low"/>
                    <ComboBoxItem Content="中" Tag="medium"/>
                    <ComboBoxItem Content="高" Tag="high"/>
                    <ComboBoxItem Content="緊急" Tag="critical"/>
                </ComboBox>

                <!-- AI Context -->
                <!-- AI Context Actions -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="GenerateDraftButton"
                            Content="AIで推敲"
                            Width="140"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Click="GenerateDraftButton_Click"/>
                    
                    <TextBlock Grid.Column="1" 
                               Text="入力された内容をAIが分析し、より伝わりやすい文章に改善します"
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Suggestions View (Initially Hidden) -->
        <Grid x:Name="SuggestionsView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="AIが推奨するヘルパー候補" FontWeight="SemiBold" FontSize="18"/>
                <TextBlock Text="最も適切なメンバーを選択して依頼を送信します" Style="{StaticResource MutedTextStyle}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SuggestionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,16" Padding="16" Background="{StaticResource BackgroundBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <DockPanel>
                                    <RadioButton GroupName="Helpers" 
                                                 Tag="{Binding UserId}"
                                                 DockPanel.Dock="Left" 
                                                 VerticalAlignment="Top" Margin="0,4,16,0"
                                                 Click="HelperRadioButton_Click"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="18"/>
                                            <TextBlock Text="{Binding Username, StringFormat=' ({0})'}" Foreground="{StaticResource TextLightBrush}"/>
                                            <Border Background="{StaticResource PrimaryGradientBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,2">
                                                <TextBlock Text="{Binding EffectiveTotalMatchScore, StringFormat='マッチ度: {0:F1}%'}" 
                                                           Foreground="{StaticResource TextWhiteBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <TextBlock Text="推奨アプローチ:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding RecommendedApproach}" TextWrapping="Wrap" Foreground="{StaticResource TextLightBrush}" FontSize="14"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    Width="120"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,16,0"/>

            <!-- Create without AI / Back Button -->
            <Button x:Name="BackOrDirectButton"
                    Content="直接作成"
                    Width="120"
                    Click="BackOrDirectButton_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,16,0"/>
            
            <!-- AI Search / Submit Button -->
            <Button x:Name="ActionButton"
                    Content="AIメンバー検索"
                    Width="140"
                    Click="ActionButton_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
