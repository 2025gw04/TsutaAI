<Window x:Class="TsutaAI.Windows.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Alert" 
        Height="Auto" 
        Width="Auto"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MinHeight="150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Style="{StaticResource AlertCard}" Margin="10">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title Bar -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title Bar (Optional, mostly for dragging) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" 
                           Text="Notification" 
                           FontWeight="Bold" 
                           FontSize="{StaticResource FontSizeNormal}" 
                           Foreground="{StaticResource TextLightBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="0,10,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border x:Name="IconContainer" 
                        Width="48" Height="48" 
                        CornerRadius="24" 
                        Background="#E0F2F1"
                        Margin="0,0,20,0"
                        VerticalAlignment="Top">
                    <iconPacks:PackIconBoxIcons x:Name="AlertIcon" 
                                                Kind="RegularCheck" 
                                                Width="24" Height="24" 
                                                Foreground="{StaticResource PrimaryBrush}" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                </Border>

                <!-- Message -->
                <TextBlock x:Name="MessageText" 
                           Grid.Column="1"
                           Text="This is a message." 
                           FontSize="{StaticResource FontSizeNormal}" 
                           FontWeight="Bold"
                           TextWrapping="Wrap" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           MaxWidth="600"
                           LineHeight="24"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource TextButton}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Visibility="Collapsed"
                        IsCancel="True"/>
                <Button x:Name="OkButton" 
                        Content="OK" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="100" 
                        Click="OkButton_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
