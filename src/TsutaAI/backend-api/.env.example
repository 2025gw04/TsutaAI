# =================================
# TsutaAI Backend API 環境変数設定
# =================================
#
# このファイルを .env にコピーして、適切な値を設定してください。
# 本番環境では必ず全ての値を変更してください。

# ---------------------------------
# サーバー設定
# ---------------------------------
NODE_ENV=production
PORT=3443

# ---------------------------------
# JWT設定（セキュリティ重要）
# ---------------------------------
# 警告: JWT_SECRETは必ず変更してください！
# 最低32文字以上のランダムな文字列を使用してください。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-CHANGE-THIS-IN-PRODUCTION
JWT_EXPIRES_IN=24h

# ---------------------------------
# Groq API設定（必須）
# ---------------------------------
# Groq APIキーは https://console.groq.com/ で取得してください
GROQ_API_KEY=your-groq-api-key-here
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# ---------------------------------
# データベース設定
# ---------------------------------
# DB_CLIENT オプション: 'development' (SQLite), 'sqlite', 'mysql', 'postgresql', 'mssql'
DB_CLIENT=development
# SQLite用（DB_CLIENT=development または sqlite の場合）
DATABASE_PATH=../database/tsutaai.db

# MySQL/PostgreSQL/MSSQL用（DB_CLIENT=mysql/postgresql/mssql の場合）
DB_HOST=localhost
DB_PORT=3306
DB_USER=tsutaai_user
DB_PASSWORD=your-database-password
DB_NAME=tsutaai
# MSSQL専用設定
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=false

# ---------------------------------
# SSL/TLS証明書設定（HTTPS用）
# ---------------------------------
# 本番環境ではHTTPSを必ず有効にしてください
ENABLE_HTTPS=true
SSL_KEY_PATH=./ssl/server.key
SSL_CERT_PATH=./ssl/server.cert

# ---------------------------------
# プロキシ設定（オプション）
# ---------------------------------
# 企業ネットワーク等でプロキシが必要な場合に設定
PROXY_ENABLED=false
PROXY_URL=http://proxy.example.com:8080
PROXY_USERNAME=
PROXY_PASSWORD=

# ---------------------------------
# ログ設定
# ---------------------------------
# ログレベル: 'error', 'warn', 'info', 'verbose', 'debug'
LOG_LEVEL=info
LOG_DIR=./logs

# ---------------------------------
# レート制限設定
# ---------------------------------
# ログインAPI用レート制限（15分間あたりの最大試行回数）
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# 一般API用レート制限（15分間あたりの最大リクエスト数）
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=900000

# ---------------------------------
# セキュリティ設定
# ---------------------------------
# データ暗号化キー（必ず変更してください）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-encryption-key-min-32-characters-CHANGE-THIS
