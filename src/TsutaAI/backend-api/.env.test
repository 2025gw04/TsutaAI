# =================================
# TsutaAI テスト環境設定
# =================================

# 環境
NODE_ENV=test
PORT=3001

# JWT設定（テスト用）
JWT_SECRET=test-jwt-secret-for-testing-only-do-not-use-in-production
JWT_EXPIRES_IN=1h

# Groq API（テスト用 - モック化推奨）
GROQ_API_KEY=test-groq-api-key
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# データベース設定（テスト用SQLite）
DB_CLIENT=better-sqlite3
DATABASE_PATH=:memory:

# HTTPS（テスト環境では無効）
ENABLE_HTTPS=false

# プロキシ（テスト環境では無効）
PROXY_ENABLED=false

# ログ設定
LOG_LEVEL=error
LOG_DIR=./logs/test
LOG_TO_CONSOLE=false

# レート制限（テスト環境では緩く設定）
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_API_MAX=10000
RATE_LIMIT_API_WINDOW_MS=60000

# セキュリティ設定（テスト用）
ENCRYPTION_KEY=test-encryption-key-for-testing-only-32-chars-min
