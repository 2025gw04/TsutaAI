<Window x:Class="TsutaAI.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource BaseWindowStyle}"
        Title="TsutaAI ログイン"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="PrimaryGradientBrush"/>
        </Grid.Background>

        <Border Background="{StaticResource WindowBackgroundBrush}"
                CornerRadius="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="40,30"
                Width="400">
            <StackPanel VerticalAlignment="Center">
                <Image Width="80" Source="/TsutaAI;component/Resources/TsutaAI_G_Trans.png"/>

                <TextBlock Text="TsutaAI へようこそ"
                           Style="{StaticResource H2}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock Text="アカウント情報を入力してログインしてください。"
                           Style="{StaticResource LightText}"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="ユーザーID"
                           Margin="0,0,0,6"
                           Foreground="{StaticResource TextLightBrush}"/>
                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource ModernTextBox}"
                         Height="40"
                         Margin="0,0,0,6"
                         Text="dev_matsumoto"
                         FontWeight="Bold"
                         />

                <TextBlock Text="パスワード"
                           Margin="0,6,0,6"
                           Foreground="{StaticResource TextLightBrush}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource PasswordBox}"
                             Height="40"
                             Padding="10,8"
                             Password="demo_password"/>

                <Button x:Name="LoginButton"
                        Style="{StaticResource PrimaryButton}"
                        Height="45"
                        Content="ログイン"
                        FontSize="18"
                        Margin="0,20,0,0"
                        Click="OnLoginClicked"/>

                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="{StaticResource ErrorBrush}"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="ProxySettingButton"
                            Content="プロキシ設定"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextLightBrush}"
                            FontSize="14"
                            Cursor="Hand"
                            Click="OnProxySettingClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="ButtonText"
                                                       Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       TextDecorations="Underline"
                                                       Cursor="Hand"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonText" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text=" | "
                               Foreground="{StaticResource TextLightBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                    <Button x:Name="ApiSettingButton"
                            Content="API設定"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextLightBrush}"
                            FontSize="14"
                            Cursor="Hand"
                            Click="OnApiSettingClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="ButtonText"
                                                       Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       TextDecorations="Underline"
                                                       Cursor="Hand"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonText" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>

        <Button VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="20, 10"
                Click="OnExitClicked"
                Style="{x:Null}"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Hidden">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#40FFFFFF"
                            CornerRadius="20"
                            Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBoxIcons Kind="RegularX"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="終了"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#60FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#80FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>