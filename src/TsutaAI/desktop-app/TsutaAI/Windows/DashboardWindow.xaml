<Window x:Class="TsutaAI.Windows.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:models="clr-namespace:TsutaAI.Models"
        xmlns:converters="clr-namespace:TsutaAI.Converters"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="TsutaAI ダッシュボード"
        Height="768"
        Width="1024"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:MinutesToTimeConverter x:Key="MinutesToTimeConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <Border Grid.Row="0" 
                Background="{StaticResource WindowBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="40" Source="/TsutaAI;component/Resources/TsutaAI_G_Trans.png"/>
                    <TextBlock Text="TsutaAI Dashboard" Style="{StaticResource H2}" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Click="SettingsButton_Click"
                            ToolTip="設定">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <iconPacks:PackIconBoxIcons Kind="RegularCog" VerticalAlignment="Center"/>
                            <TextBlock Text="設定" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NotificationsButton"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Click="NotificationsButton_Click"
                            ToolTip="通知">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Grid>
                                <iconPacks:PackIconBoxIcons Kind="RegularBell" VerticalAlignment="Center"/>
                                <Grid x:Name="NotificationBadge" Width="16" Height="16" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="-8,-6,-6,0" Visibility="Collapsed">
                                    <Ellipse Fill="{StaticResource ErrorBrush}"/>
                                    <TextBlock x:Name="NotificationCountText" Text="1" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <TextBlock Text="通知" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Padding="12,0"
                            Click="LogoutButton_Click"
                            ToolTip="ログアウト">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <iconPacks:PackIconBoxIcons2 Kind="RegularLogOut" VerticalAlignment="Center"/>
                            <TextBlock Text="ログアウト" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">
            <Grid MaxWidth="1200" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- 左カラム：メインタスクエリア -->
                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <!-- 挨拶 -->
                    <TextBlock x:Name="GreetingTextBlock"
                               Style="{StaticResource H1}"
                               FontSize="30"
                               Text="ようこそ、ゲストユーザーさん"
                               Margin="0,10,0,5"/>

                    <TextBlock Style="{StaticResource LightText}"
                               FontSize="18"
                               Margin="0,0,0,25"
                               Text="今日のタスクを選択して作業を始めましょう"/>

                    <!-- 作業開始ボタン (目立つ位置に配置) -->
                    <Button x:Name="StartWorkButton"
                            Style="{StaticResource PrimaryGradientButton}"
                            Height="56"
                            FontSize="24"
                            Margin="0,0,0,30"
                            Click="OnStartWorkClicked"
                            Cursor="Hand">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlayCircle" Width="24" Height="26" Margin="0,1,10,0"/>
                                <TextBlock x:Name="StartWorkButtonText" Text="今日の作業を開始" FontWeight="Bold" FontSize="20"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- タスクリスト -->
                    <TextBlock Text="今日のタスク一覧" Style="{StaticResource H2}" FontSize="20" Margin="0,0,0,15"/>
                    
                    <TextBlock x:Name="EmptyTasksMessage"
                               Text="本日のタスクは登録されていません。"
                               Style="{StaticResource LightText}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,20"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="TasksItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TaskItem}">
                                <Border Background="{StaticResource WindowBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="5" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 選択チェックボックス -->
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,15,0"
                                                  Checked="OnTaskSelectionChanged"
                                                  Unchecked="OnTaskSelectionChanged">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>

                                        <!-- タスク情報 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Title}"
                                                        FontWeight="SemiBold"
                                                        FontSize="18"
                                                        TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProjectName}"
                                                        Style="{StaticResource MutedTextStyle}"
                                                        Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <iconPacks:PackIconBoxIcons2 Kind="RegularTimeFive" Width="14" Height="14" VerticalAlignment="Center" Foreground="{StaticResource LightTextBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Style="{StaticResource LightText}" FontSize="15">
                                                    <Run Text="{Binding EstimatedMinutes, Converter={StaticResource MinutesToTimeConverter}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 優先度ラベル -->
                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                Margin="0,0,15,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="Medium" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Priority}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                <Setter Property="Text" Value="High"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                <Setter Property="Text" Value="Medium"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                <Setter Property="Text" Value="Low"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 詳細ボタン -->
                                        <Button Grid.Column="3"
                                                Style="{StaticResource TextButton}"
                                                Padding="8"
                                                Click="OnOpenTaskDetail"
                                                Tag="{Binding}"
                                                ToolTip="詳細を表示">
                                            <iconPacks:PackIconBoxIcons Kind="RegularInfoCircle" Width="20" Height="20" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 選択したタスクの順番設定パネル -->
                    <Border x:Name="SelectedTasksPanel"
                            Background="#FFFBEB"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <iconPacks:PackIconBoxIcons Kind="RegularListOl" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Style="{StaticResource H2}" FontSize="18" Text="実行順序の確認" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                            
                            <ItemsControl x:Name="SelectedTasksItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TaskItem}">
                                        <Border Background="{StaticResource WindowBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="▶" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource SecondaryButton}" Height="24" Width="24" Padding="0" Margin="0,0,4,0" Click="OnMoveTaskUp" Tag="{Binding}">
                                                        <iconPacks:PackIconBoxIcons Kind="RegularChevronUp" Width="12" Height="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Height="24" Width="24" Padding="0" Click="OnMoveTaskDown" Tag="{Binding}">
                                                        <iconPacks:PackIconBoxIcons Kind="RegularChevronDown" Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右カラム：サイドバー（AI & メニュー） -->
                <StackPanel Grid.Column="1">
                    
                    <!-- AIメッセージ -->
                    <Border Background="#F0FDF4" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,10,0,25">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="20" Width="32" Height="32" Margin="0,0,10,0">
                                    <iconPacks:PackIconBoxIcons Kind="RegularFace" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="AIアシスタント" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="AiMessageTextBlock"
                                       Text="作業を開始する前に、今日の目標を整理しましょう。"
                                       TextWrapping="Wrap"
                                       LineHeight="24"
                                       FontSize="16"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- クイックメニュー -->
                    <TextBlock Text="クイックメニュー" Style="{StaticResource H3}" Margin="0,0,0,15"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: メイン機能 -->
                        <Button x:Name="ProjectDashboardButton" Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="ProjectDashboardButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons2 Kind="RegularStats" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="プロジェクト" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="OpenKanbanButton" Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="OpenKanbanButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons2 Kind="RegularListCheck" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="看板ボード" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Row 2: 分析・成長 -->
                        <Button x:Name="GrowthTrackingButton" Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="GrowthTrackingButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons Kind="RegularTrendingUp" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="成長記録" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ViewAiAnalysisButton" Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="ViewAiAnalysisButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons Kind="RegularBarChart" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="AI活動分析" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ManageProjectsButton" Grid.Row="4" Grid.Column="0"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="ManageProjectsButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons Kind="RegularFolder" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="プロジェクト管理" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Row 6: ヘルスケアなど -->
                        <Button x:Name="MentalHealthCheckButton" Grid.Row="4" Grid.Column="2"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="MentalHealthCheckButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons Kind="RegularSmile" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="メンタル" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CreateHelpRequestButton" Grid.Row="6" Grid.Column="0"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="CreateHelpRequestButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons Kind="RegularHelpCircle" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="ヘルプ依頼" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AiAssistantButton" Grid.Row="6" Grid.Column="2"
                                Style="{StaticResource SecondaryButton}" Height="90" Click="AiAssistantButton_Click"
                                BorderThickness="1" Background="White">
                            <StackPanel>
                                <iconPacks:PackIconBoxIcons Kind="SolidFace" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="AIアシスタント" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>