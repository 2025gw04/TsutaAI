<Window x:Class="TsutaAI.Windows.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロジェクト編集" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource BaseWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- フォーム -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- プロジェクト名 -->
                <TextBlock Text="プロジェクト名 *"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="ProjectNameTextBox"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,20"/>

                <!-- 説明 -->
                <TextBlock Text="説明"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="DescriptionTextBox"
                         Style="{StaticResource ModernTextBox}"
                         Height="100"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20"/>

                <!-- 開始日 -->
                <TextBlock Text="開始日 *"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <DatePicker x:Name="StartDatePicker"
                            Style="{StaticResource ModernDatePicker}"
                            Margin="0,0,0,20"/>

                <!-- 終了日 -->
                <TextBlock Text="終了日 *"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <DatePicker x:Name="EndDatePicker"
                            Style="{StaticResource ModernDatePicker}"
                            Margin="0,0,0,20"/>

                <!-- ステータス -->
                <TextBlock Text="ステータス *"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="StatusComboBox"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="計画中" Tag="planning"/>
                    <ComboBoxItem Content="進行中" Tag="active"/>
                    <ComboBoxItem Content="完了" Tag="completed"/>
                    <ComboBoxItem Content="中止" Tag="cancelled"/>
                </ComboBox>

                <!-- 必須項目の注記 -->
                <TextBlock Text="* は必須項目です"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="キャンセル"
                    Width="120"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"/>
            
            <Button x:Name="SaveButton"
                    Content="保存"
                    Width="120"
                    Click="SaveButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>