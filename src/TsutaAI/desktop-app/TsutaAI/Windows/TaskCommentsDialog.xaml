<Window x:Class="TsutaAI.Windows.TaskCommentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タスクコメント" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource BaseWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20">
            <StackPanel>
                <TextBlock Text="タスク:"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="TaskNameText"
                           Style="{StaticResource H2}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- コメント一覧 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">
            <StackPanel x:Name="CommentsPanel">
                <!-- ローディング表示 -->
                <TextBlock x:Name="LoadingText"
                           Text="コメントを読み込み中..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,60,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="16"/>

                <!-- コメントなし表示 -->
                <TextBlock x:Name="NoCommentsText"
                           Text="まだコメントがありません"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,60,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="16"
                           Visibility="Collapsed"/>

                <!-- コメントリスト（動的に追加） -->
                <ItemsControl x:Name="CommentsList"
                              Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WindowBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- ユーザー名と日時 -->
                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="{Binding UserName}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding TimeAgo}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextLightBrush}"
                                                   Margin="12,2,0,0"/>
                                    </StackPanel>

                                    <!-- コメント内容 -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource Body}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- フッター -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="閉じる"
                        Width="100"
                        Click="CloseButton_Click"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"/>
                
                <Button x:Name="AddCommentButton"
                        Content="コメント追加"
                        Width="140"
                        Click="AddCommentButton_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>