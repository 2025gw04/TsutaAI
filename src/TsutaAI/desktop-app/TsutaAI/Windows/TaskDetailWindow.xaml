<Window x:Class="TsutaAI.Windows.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource BaseWindowStyle}"
        Title="タスク詳細"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        >
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <!--<Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="30,25" MouseDown="HeaderBd_MouseDown" Background="{StaticResource PrimaryGradientBrush}">
            <StackPanel>
                <TextBlock x:Name="TaskTitleText"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>
                <TextBlock x:Name="ProjectNameText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextWhiteBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PriorityLabel"
                                       Grid.Column="0"
                                       FontSize="16"
                                       Foreground="{StaticResource TextWhiteBrush}"/>
                    <TextBlock x:Name="StatusLabel"
                                       Grid.Column="1"
                                       FontSize="16"
                                       Foreground="{StaticResource TextWhiteBrush}"/>
                    <TextBlock x:Name="AssigneeLabel"
                                       Grid.Column="2"
                                       FontSize="16"
                                       Foreground="{StaticResource TextWhiteBrush}"/>
                </Grid>
            </StackPanel>
        </Border>-->

        <!-- ========== ヘッダー ========== -->
        <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel>
                <TextBlock x:Name="TaskTitleText"
                            FontSize="28"
                            FontWeight="Bold"
                            TextWrapping="Wrap"
                            Margin="0,0,0,5"
                           Text=""
                           />
                <TextBlock x:Name="ProjectNameText"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Margin="0,0,0,10"
                           Text=""/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PriorityLabel"
                                Grid.Column="0"
                                FontSize="16"
                               Text=""
                                       />
                    <TextBlock x:Name="StatusLabel"
                                Grid.Column="1"
                                FontSize="16"
                               Text=""
                               />
                    <TextBlock x:Name="AssigneeLabel"
                                Grid.Column="2"
                                FontSize="16"
                               Text=""
                               />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                            x:Name="MainTabControl"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                                Background="Transparent"
                                                BorderThickness="0,0,0,3"
                                                BorderBrush="Transparent"
                                                Padding="20,12"
                                                Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter ContentSource="Header"
                                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 詳細タブ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularInfoCircle" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="詳細" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,20">
                    <StackPanel>
                        <!-- 時間情報カード -->
                        <Border Background="{StaticResource WindowBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="20"
                                        Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <iconPacks:PackIconBoxIcons2 Kind="RegularTimeFive"
                                                                            Width="20"
                                                                            Height="20"
                                                                            Foreground="{StaticResource PrimaryBrush}"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,10,0"/>
                                        <TextBlock Text="予定時間"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextLightBrush}"
                                                           VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimeLabel"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Margin="30,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <iconPacks:PackIconBoxIcons Kind="RegularTachometer"
                                                                            Width="20"
                                                                            Height="20"
                                                                            Foreground="{StaticResource AccentBrush}"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,10,0"/>
                                        <TextBlock Text="進捗"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextLightBrush}"
                                                           VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ProgressLabel"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="30,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- タスク詳細カード -->
                        <Border Background="{StaticResource WindowBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <iconPacks:PackIconBoxIcons Kind="RegularInfoCircle"
                                                                        Width="20"
                                                                        Height="20"
                                                                        Foreground="{StaticResource PrimaryBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                    <TextBlock Text="タスク詳細"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="#F8F9FA"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="18"
                                                MinHeight="150">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                        <TextBlock x:Name="DescriptionText"
                                                           TextWrapping="Wrap"
                                                           LineHeight="24"
                                                           FontSize="16"
                                                           Foreground="{StaticResource TextBrush}"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- コメントタブ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularMessage" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CommentTabHeader" Text="コメント" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- コメント一覧 -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CommentsListBox">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12"
                                                    Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- アバター -->
                                            <Border Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="16"
                                                            Background="#E0E0E0"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,12,0">
                                                <iconPacks:PackIconBoxIcons Kind="RegularUser"
                                                                                    Width="20"
                                                                                    Height="20"
                                                                                    Foreground="#9CA3AF"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- コンテンツ -->
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding UserName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="15"
                                                                       Foreground="#111827"/>
                                                    <TextBlock Text="{Binding TimeAgo}"
                                                                       FontSize="13"
                                                                       Foreground="#9CA3AF"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Content}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="15"
                                                                   Foreground="#374151"
                                                                   LineHeight="20"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- コメント入力 -->
                    <Border Grid.Row="1"
                                    Background="{StaticResource WindowBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="CommentInputBox"
                                             Grid.Row="0"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="80"
                                             MaxHeight="150"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             Padding="12"
                                             FontSize="15"
                                             VerticalScrollBarVisibility="Auto"/>

                            <Button Grid.Row="1"
                                            Content="コメントを追加"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            Width="140"
                                            Height="36"
                                            Margin="0,12,0,0"
                                            Click="OnAddComment"
                                            Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 添付ファイルタブ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularPaperclip" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AttachmentTabHeader" Text="添付ファイル" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- アップロードボタン -->
                    <Button Grid.Row="0"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right"
                                    Width="180"
                                    Height="36"
                                    Margin="0,0,0,16"
                                    Click="OnUploadAttachment"
                                    Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons2 Kind="RegularCloudUpload" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="ファイルをアップロード" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- 添付ファイル一覧 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AttachmentsListBox">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WindowBackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                            Background="{StaticResource PrimaryBrush}"
                                                            CornerRadius="6"
                                                            Width="40"
                                                            Height="40"
                                                            Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileExtension}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileSizeFormatted}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextLightBrush}"
                                                                       Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding UploaderName}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextLightBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                            Content="ダウンロード"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Width="120"
                                                            Height="32"
                                                            Click="OnDownloadAttachment"
                                                            Tag="{Binding Id}"
                                                            Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 履歴タブ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularHistory" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="履歴" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="30,20">
                    <ItemsControl x:Name="ActivityListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WindowBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="16"
                                                Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="20"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,12,0">
                                            <iconPacks:PackIconBoxIcons Kind="{Binding ActionIcon}"
                                                                                Width="16"
                                                                                Height="16"
                                                                                Foreground="White"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding UserName}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ActionDisplayName}"
                                                                   FontSize="15"
                                                                   Foreground="{StaticResource TextLightBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               Foreground="{StaticResource TextLightBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                           Text="{Binding TimeAgo}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextLightBrush}"
                                                           VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
                        Background="#F8F9FA"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,18,18"
                        Padding="30,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}"
                                    Width="110"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Click="OnStart"
                                    Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPlay" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="開始" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                                    Width="120"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    Click="OnPause"
                                    Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularPause" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="一時停止" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Style="{StaticResource SuccessButton}"
                                    Width="110"
                                    Height="35"
                                    Click="OnComplete"
                                    Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularCheck" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="完了" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                                Content="閉じる"
                                Style="{StaticResource SecondaryButton}"
                                Width="100"
                                Height="35"
                                Click="OnClose"
                                Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
